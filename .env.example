# Your Gemini key (aistudio.google.com > Get API key). Without it Glyph runs with fake answers.
GEMINI_API_KEY=

# Optional tuning. Remove the # to use one.
# GLYPH_MODEL=gemini-flash-latest
# GLYPH_COOLDOWN_SECONDS=4
# GLYPH_MAX_CALLS_PER_MIN=8
# GLYPH_SETTLE_SECONDS=1.0
# GLYPH_INK_C=14
# GLYPH_THINKING_BUDGET=0   (faster answers on models that allow turning thinking off)
