# Your Gemini key (aistudio.google.com > Get API key). Without it Glyph runs with fake answers.
GEMINI_API_KEY=

# The name shown in the app and used in the answers:
# GLYPH_NAME=Glyph

# Optional tuning. Remove the # to use one.
# The model tried first:
# GLYPH_MODEL=gemini-3.5-flash-lite
# Fewest seconds between two reads, and most reads in one minute. On a free key, or a key someone
# lent you, 6 and 4 make the day's allowance last longer:
# GLYPH_COOLDOWN_SECONDS=4
# GLYPH_MAX_CALLS_PER_MIN=8
# GLYPH_SETTLE_SECONDS=1.0
# GLYPH_INK_C=14
# Give up on a slow model call after this long and try the next model (10 is the shortest Gemini allows):
# GLYPH_TIMEOUT_SECONDS=10
# Model thinking is off by default, for speed. -1 lets the model decide:
# GLYPH_THINKING_BUDGET=-1
# The tuning page (http://127.0.0.1:8765/tune) writes GLYPH_INK_C, GLYPH_MIN_NEW_INK_PX,
# GLYPH_SETTLE_SECONDS, GLYPH_COVER_DIFF and GLYPH_HSV_<COLOR> lines here when you press Save.
